---
export interface Props {
  title?: string;
  agenceNom?: string;
}
const { title = 'IKAN AI — Votre avis', agenceNom } = Astro.props;
---
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Donnez votre avis sur votre expérience en agence — IKAN AI" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style is:global>
      :root {
        --color-dark: #02302D;          /* Vert Midnight très foncé */
        --color-primary: #3C7730;       /* Vert Forêt */
        --color-accent: #75B72A;        /* Vert Pomme */
        --color-lime: #BCCF00;          /* Jaune Lime Flash */
        --color-bg-dark: #02302D;
        --color-card-bg: #FFFFFF;
        --color-text-dark: #02302D;
        --color-text-muted: #6B7280;
        --color-border-lime: #BCCF00;
        --font-heading: 'Outfit', sans-serif;
        --font-body: 'Plus Jakarta Sans', sans-serif;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--font-body);
        background-color: var(--color-bg-dark);
        color: var(--color-text-dark);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 20px 12px;
      }

      .mobile-container {
        width: 100%;
        max-width: 440px;
        background: #FFFFFF;
        border-radius: 36px;
        border: 2px solid var(--color-border-lime);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
        padding: 32px 24px;
        position: relative;
        min-height: 620px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      h1, h2, h3 {
        font-family: var(--font-heading);
      }

      button, input, textarea {
        font-family: var(--font-body);
      }
    </style>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

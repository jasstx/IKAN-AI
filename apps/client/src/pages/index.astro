---
import FeedbackLayout from '../layouts/FeedbackLayout.astro';
import IkanLogo from '../components/IkanLogo.astro';
---
<FeedbackLayout title="IKAN AI — Scan QR">
  <div class="card" style="text-align:center; padding: 48px 24px;">
    <div style="display:flex; justify-content:center; margin-bottom:20px;">
      <IkanLogo variant="dark" size={54} />
    </div>
    <h1 style="font-size:1.15rem; color:var(--color-text-muted); font-weight:500; line-height:1.5;">
      Scannez le QR Code présent en agence pour donner votre avis instantanément.
    </h1>
  </div>
</FeedbackLayout>
